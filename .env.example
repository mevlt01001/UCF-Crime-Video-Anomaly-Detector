# EVREN API (required for LLM/VLM features)
EVREN_API_KEY="replace-with-your-api-key"
EVREN_BASE_URL="https://your-evren-endpoint.example/v1"
EVREN_LLM_MODEL="llm-fast"
EVREN_VLM_MODEL="vlm"

# Anomaly segmenter
AS_MODEL_NAME="s3d"
AS_FC_CHECKPOINT="Checkpoint/best_loss_fold_3.pt"
AS_CLIP_SIZE=32
AS_OVERLAP=16
AS_FPS=20
AS_WIDTH=224
AS_HEIGHT=224
AS_BATCH=5

# Optional TensorRT engine (CUDA only)
# AS_TRT_PLAN_PATH="Checkpoint/model.plan"

# VLM sampling and encoding
VLM_SOURCE_SAMPLE_FPS=5
VLM_MAX_FRAMES=128
VLM_MIN_FRAMES=8
VLM_MAX_EDGE=448
VLM_DIMENSION_ALIGNMENT=32
VLM_DEFAULT_ENCODE_FPS=5
VLM_MIN_ENCODE_FPS=0.25
VLM_MAX_ENCODE_FPS=30

# Optional custom VLM system prompt
# VLM_SYSTEM_PROMT=""
