# EVREN API (required for LLM/VLM features)
EVREN_API_KEY="replace-with-your-api-key"
EVREN_BASE_URL="https://your-evren-endpoint.example/v1"
EVREN_LLM_MODEL="llm-fast"
EVREN_VLM_MODEL="vlm"

# Anomaly segmenter
AS_MODEL_NAME="s3d"
AS_FC_CHECKPOINT="Checkpoint/best_loss_fold_3.pt"
# cuda | cpu | mps. Boşsa: CUDA varsa CUDA, yoksa CPU (S3D MPS'te max_pool3d yok).
# AS_DEVICE="cpu"
AS_CLIP_SIZE=32
AS_OVERLAP=16
AS_FPS=20
AS_WIDTH=224
AS_HEIGHT=224
AS_BATCH=5

# Optional TensorRT engine (CUDA only)
# AS_TRT_PLAN_PATH="Checkpoint/model.plan"

# VLM sampling and encoding
VLM_SOURCE_SAMPLE_FPS=5
VLM_MAX_FRAMES=128
VLM_MIN_FRAMES=8
VLM_MAX_EDGE=448
VLM_DIMENSION_ALIGNMENT=32
VLM_DEFAULT_ENCODE_FPS=5
VLM_MIN_ENCODE_FPS=0.25
VLM_MAX_ENCODE_FPS=30

# Optional custom VLM system prompt
# VLM_SYSTEM_PROMT=""

# Optional YOLO11 object detection (requirements-objects.txt + downloaded weights)
OBJECT_MODEL_PATH="_stuff/models/yolo11s.pt"
OBJECT_DEVICE="auto"
OBJECT_IMAGE_SIZE=640
OBJECT_CONFIDENCE=0.25
OBJECT_MAX_DETECTIONS=100
OBJECT_MAX_FRAMES=18000
OBJECT_TIMEOUT_SEC=900

# Optional local plate-region detection (no OCR; CPU ONNX Runtime)
PLATE_MODEL_PATH="_stuff/models/yolo-v9-t-384-license-plates-end2end.onnx"
PLATE_CONFIDENCE=0.25
PLATE_MAX_FRAMES=1800
PLATE_MAX_CROPS=500
PLATE_TIMEOUT_SEC=300

# Optional OCR of existing plate crops (CPU; separate from detection)
PLATE_OCR_MODEL_PATH="_stuff/models/cct_xs_v2_global.onnx"
PLATE_OCR_CONFIG_PATH="_stuff/models/cct_xs_v2_global_plate_config.yaml"
PLATE_OCR_MIN_CONFIDENCE=0.8
PLATE_OCR_MAX_CROPS=500
PLATE_OCR_TIMEOUT_SEC=120

# Optional web app settings
# WEB_HOST="127.0.0.1"
# WEB_PORT=8000
